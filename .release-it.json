{
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "pushArgs": ["--follow-tags", "--atomic"]
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": [
      "pnpm check",
      "npm pack --dry-run --registry=https://registry.npmjs.org/"
    ],
    "after:bump": "pnpm install --lockfile-only --ignore-scripts --offline --no-frozen-lockfile"
  }
}
